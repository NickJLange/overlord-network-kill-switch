#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
echo 'Installing orb Docker prerequisites if missing'
if ! command -v dockerd >/dev/null || ! docker compose version >/dev/null 2>&1; then
    if [[ ! -f /etc/apt/sources.list.d/docker.list ]]; then
        sudo install -m 0755 -d /etc/apt/keyrings
        sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
        sudo chmod a+r /etc/apt/keyrings/docker.asc
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
    fi
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi
if ! command -v openssl >/dev/null; then
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y openssl
fi
echo 'Syncing Python 3.12 and locked project/test dependencies'
uv sync --locked
echo 'Preparing isolated MQTT lab configuration'
scripts/lab prepare
echo 'Ready. Start services with: amp orb services ensure'
